{
  "name": "matrix-movil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:apk": "vue-tsc --noEmit && vite build --mode apk && cap sync android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
